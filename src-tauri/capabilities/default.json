{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "FrameRaw desktop permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "frameraw-backend", "sidecar": true, "args": true }]
    }
  ]
}
