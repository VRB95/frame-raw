{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameRaw",
  "version": "0.1.0",
  "identifier": "com.frameraw.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "FrameRaw",
      "width": 1280,
      "height": 820,
      "minWidth": 900,
      "minHeight": 620,
      "dragDropEnabled": true,
      "backgroundColor": "#171714"
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' asset: http://asset.localhost blob: data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/frameraw-backend"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
